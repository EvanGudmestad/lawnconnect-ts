{
  "name": "lawconnect-ts",
  "version": "1.0.0",
  "description": "Connecting mowing professionals with residential and business clients",
  "homepage": "https://github.com/EvanGudmestad/lawnconnect-ts#readme",
  "bugs": {
    "url": "https://github.com/EvanGudmestad/lawnconnect-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvanGudmestad/lawnconnect-ts.git"
  },
  "license": "MIT",
  "author": "Evan Gudmestad",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file .env src/index.ts",
    "build": "tsc && npm install --prefix vite-project && npm run build --prefix vite-project",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "supertest": "^7.3.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "mongodb": "^7.6.0",
    "zod": "^4.6.5"
  }
}
